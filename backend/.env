# --- Postgres (one-time settings: module/screen enabled-component flags) ---
# service/settings_service.py auto-creates the "settings" table on startup
# if it doesn't exist yet — no separate migration step needed.
DATABASE_URL=postgresql://user:password@localhost:5433/demo_data_generator

# --- APM (the external system generated rows can be saved into) ---
# Base host serving both each module's live swagger.json and its real
# Save* endpoints. Never hardcode this in source — it's read from here so
# no real hostname needs to live in the codebase.
APM_DOC_HOST=https://api-dev.goodbookserp.in

# --- Schema cache (tools/schema_cache.py) ---
# Set to "1"/"true" to force re-parsing every screen on every request
# (useful while iterating on tools/schema_parser.py itself).
DISABLE_SCHEMA_CACHE=false
